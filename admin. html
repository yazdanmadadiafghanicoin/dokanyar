
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#10251b">
  <title>مدیریت دوکان‌یار</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Tahoma, Arial, sans-serif;
      background: #f3f6f4;
      color: #17251d;
    }
    header {
      background: #10251b;
      color: white;
      padding: 22px 16px;
    }
    header h1 { margin: 0 0 8px; font-size: 23px; }
    header p { margin: 0; color: #d0ded4; font-size: 13px; }
    main { max-width: 850px; margin: auto; padding: 16px; }
    .panel, .request {
      background: white;
      border: 1px solid #e0e7e2;
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 3px 12px #10251b0a;
    }
    label { display: block; margin: 12px 0 7px; font-size: 14px; }
    input, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccd7cf;
      border-radius: 9px;
      font: inherit;
      font-size: 14px;
      background: white;
    }
    button {
      border: 0;
      border-radius: 9px;
      padding: 12px 15px;
      font: inherit;
      cursor: pointer;
      margin: 5px 3px 0 0;
    }
    .primary { background: #176b43; color: white; }
    .approve { background: #176b43; color: white; }
    .reject { background: #b42318; color: white; }
    .secondary { background: #e8eee9; color: #17251d; }
    .muted { color: #64736a; font-size: 13px; }
    .status {
      display: inline-block;
      border-radius: 20px;
      background: #fff1cc;
      color: #805500;
      padding: 5px 10px;
      font-size: 12px;
    }
    .approved { background: #dff6e7; color: #176b43; }
    .rejected { background: #ffe5e2; color: #b42318; }
    .request h3 { margin: 0 0 12px; font-size: 17px; }
    .request p { line-height: 1.8; margin: 5px 0; font-size: 14px; }
    #message { margin-top: 12px; font-size: 14px; line-height: 1.8; }
    .hidden { display: none; }
    .actions { margin-top: 12px; }
  </style>
</head>
<body>
<header>
  <h1>مدیریت دوکان‌یار</h1>
  <p>بررسی درخواست‌های فعال‌سازی رایگان دایمی</p>
</header>

<main>
  <section class="panel">
    <h2>ورود مدیر</h2>
    <p class="muted">
      کلید مدیر همان مقدار DOKANYAAR_ADMIN_KEY در تنظیمات Vercel است.
    </p>
    <label for="adminKey">کلید مدیر</label>
    <input id="adminKey" type="password"
      autocomplete="current-password"
      placeholder="کلید مدیر را وارد کنید">
    <button class="primary" id="loadBtn">نمایش درخواست‌ها</button>
    <button class="secondary" id="clearBtn">پاک‌کردن کلید</button>
    <div id="message" role="status"></div>
  </section>

  <section>
    <h2>درخواست‌ها</h2>
    <p class="muted">
      تأیید درخواست، اشتراک را دایمی و رایگان فعال می‌کند.
      برای رد درخواست، نوشتن دلیل الزامی است.
    </p>
    <div id="requests"></div>
  </section>
</main>

<script>
  const API = "/api/activation";
  const keyInput = document.getElementById("adminKey");
  const list = document.getElementById("requests");
  const message = document.getElementById("message");

  function showMessage(text, error = false) {
    message.textContent = text;
    message.style.color = error ? "#b42318" : "#176b43";
  }

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  async function api(path, options = {}) {
    const response = await fetch(
      API + "?path=" + encodeURIComponent(path),
      {
        ...options,
        headers: {
          "Content-Type": "application/json",
          "X-Admin-Key": keyInput.value.trim(),
          ...(options.headers || {})
        }
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok || data.success === false) {
      throw new Error(data.error || "درخواست ناموفق بود.");
    }
    return data;
  }

  function statusLabel(status) {
    const labels = {
      pending: ["در انتظار بررسی", ""],
      approved: ["تأیید شده", "approved"],
      rejected: ["رد شده", "rejected"]
    };
    return labels[status] || [status || "نامشخص", ""];
  }

  async function loadRequests() {
    const key = keyInput.value.trim();

    if (!key) {
      showMessage("ابتدا کلید مدیر را وارد کنید.", true);
      return;
    }

    list.textContent = "در حال بارگذاری...";
    showMessage("");

    try {
      const data = await api("admin/activation-requests");
      const requests = data.requests || [];

      if (!requests.length) {
        list.textContent = "هنوز درخواستی ثبت نشده است.";
        showMessage("ارتباط با API موفق بود.");
        return;
      }

      list.innerHTML = requests.map(item => {
        const status = statusLabel(item.status);
        const date = item.requested_at
          ? new Date(item.requested_at).toLocaleString("fa-AF")
          : "نامشخص";

        return `
          <article class="request">
            <h3>درخواست شماره ${escapeHTML(item.id)}</h3>
            <p><b>نام دوکان:</b> ${escapeHTML(item.shop_name || "ثبت نشده")}</p>
            <p><b>صاحب دوکان:</b> ${escapeHTML(item.owner_name || item.full_name || "ثبت نشده")}</p>
            <p><b>ایمیل:</b> ${escapeHTML(item.email || "ثبت نشده")}</p>
            <p><b>تاریخ درخواست:</b> ${escapeHTML(date)}</p>
            <p><b>وضعیت:</b>
              <span class="status ${status[1]}">${escapeHTML(status[0])}</span>
            </p>
            ${item.admin_note
              ? `<p><b>یادداشت مدیر:</b> ${escapeHTML(item.admin_note)}</p>`
              : ""}
            ${item.status === "pending" ? `
              <label for="reason-${item.id}">دلیل رد (هنگام رد الزامی است)</label>
              <textarea id="reason-${item.id}" rows="2"
                placeholder="اگر درخواست را رد می‌کنید، دلیل را بنویسید"></textarea>
              <div class="actions">
                <button class="approve"
                  onclick="reviewRequest(${Number(item.id)}, 'approve')">
                  تأیید و فعال‌سازی رایگان
                </button>
                <button class="reject"
                  onclick="reviewRequest(${Number(item.id)}, 'reject')">
                  رد درخواست
                </button>
              </div>
            ` : ""}
          </article>
        `;
      }).join("");

      showMessage("درخواست‌ها بارگذاری شدند: " + requests.length);
    } catch (error) {
      list.textContent = "";
      showMessage(error.message, true);
    }
  }

  async function reviewRequest(id, decision) {
    let reason = "";

    if (decision === "approve") {
      if (!confirm("آیا می‌خواهید این حساب را دایمی و رایگان فعال کنید؟")) {
        return;
      }
    } else {
      const field = document.getElementById("reason-" + id);
      reason = field ? field.value.trim() : "";

      if (!reason) {
        showMessage("برای رد درخواست، دلیل را بنویسید.", true);
        if (field) field.focus();
        return;
      }

      if (!confirm("آیا از رد این درخواست مطمئن هستید؟")) {
        return;
      }
    }

    try {
      const result = await api("admin/review-activation", {
        method: "POST",
        body: JSON.stringify({
          request_id: id,
          decision,
          reason
        })
      });

      showMessage(result.message || "عملیات انجام شد.");
      await loadRequests();
    } catch (error) {
      showMessage(error.message, true);
    }
  }

  document.getElementById("loadBtn").addEventListener("click", loadRequests);

  document.getElementById("clearBtn").addEventListener("click", () => {
    keyInput.value = "";
    list.textContent = "";
    showMessage("کلید از این صفحه پاک شد.");
  });

  keyInput.addEventListener("keydown", event => {
    if (event.key === "Enter") loadRequests();
  });
</script>
</body>
</html>
